<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- app version from the repo's VERSION file (stamped on generated maps) -->
    <Version Condition="Exists('$(MSBuildThisFileDirectory)../../VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generation/style-prior.json" LogicalName="Abeat.Core.style-prior.json" />
  </ItemGroup>

</Project>
